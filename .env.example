# Recycling calendar API configuration examples.
# docker compose reads these automatically when this file is named ".env".

# --- PostgreSQL service ---
POSTGRES_DB=recycle
POSTGRES_USER=recycle
POSTGRES_PASSWORD=recycle
# Host port mapped to the database container (container port is always 5432).
POSTGRES_PORT_PUBLISH=5432

# --- API service ---
# Host port mapped to the API container (container port is always 8000).
APP_PORT_PUBLISH=8000
# Largest accepted inclusive query span in days.
MAX_QUERY_DAYS=370

# --- Appointment limits ---
# A booking start must be at most this many days in the future.
BOOKING_MAX_LEAD_DAYS=30
# A single appointment may last at most this many hours.
BOOKING_MAX_DURATION_HOURS=2

# When running the API outside compose you can instead set one full URI:
# DATABASE_URL=postgresql://recycle:recycle@localhost:5432/recycle
